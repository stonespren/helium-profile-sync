#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/helium-profile-sync"
CONFIG_FILE="$CONFIG_DIR/config"
RCLONE_CONF="$CONFIG_DIR/rclone.conf"
LOCK_FILE="/tmp/helium-profile-sync-$(id -u).lock"
BISYNC_STATE_DIR="$CONFIG_DIR/bisync-state"

BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

msg()  { echo -e "${GREEN}[$(date -Iseconds)]${RESET} $1"; }
warn() { echo -e "${YELLOW}[$(date -Iseconds)] WARNING:${RESET} $1"; }
err()  { echo -e "${RED}[$(date -Iseconds)] ERROR:${RESET} $1" >&2; }

usage() {
    cat <<EOF
Usage: helium-profile-sync [OPTION]

Options:
  --setup         Run the interactive setup wizard
  --sync-now      Trigger an immediate sync
  --status        Show systemd timer and service status
  --logs          Show recent journal logs
  --enable        Enable and start the systemd timer
  --disable       Disable and stop the systemd timer
  --dry-run       Perform a sync dry-run (no changes)
  --restore       Download profiles from S3 (backs up local first, then overwrites)
  --restore-merge Download profiles from S3 (merge, no local deletions)
  --register      Register synced profiles in Helium's Local State file
  -h, --help      Show this help message
  (no args)       Run sync (used by systemd service)
EOF
}

load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        err "Config not found. Run 'helium-profile-sync --setup' first."
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
}

build_exclude_args() {
    EXCLUDE_ARGS=()
    IFS=',' read -ra _patterns <<< "$EXCLUDE_PATTERNS"
    for pattern in "${_patterns[@]}"; do
        pattern=$(echo "$pattern" | xargs)  # trim whitespace
        [[ -n "$pattern" ]] && EXCLUDE_ARGS+=(--exclude "$pattern")
    done
}

# ── Register synced profiles in Helium's Local State ──────────
# Chromium-based browsers track known profiles in a "Local State"
# JSON file.  If a profile folder is synced to a new machine but
# has no entry in profile.info_cache, the browser won't show it.
# This function reads each synced profile's Preferences to get
# its display name and avatar, then inserts a stub entry into
# Local State so Helium recognizes it on next launch.
register_profiles() {
    local local_state="$HELIUM_DATA_DIR/Local State"

    if ! command -v jq &>/dev/null; then
        warn "jq not found — skipping Local State registration."
        return
    fi

    # Ensure Local State exists with minimal structure
    if [[ ! -f "$local_state" ]]; then
        msg "Creating new Local State file"
        cat > "$local_state" <<'TMPL'
{
  "profile": {
    "info_cache": {},
    "last_active_profiles": [],
    "last_used": "Default",
    "metrics": { "next_bucket_index": 1 },
    "profiles_created": 0,
    "profiles_order": []
  }
}
TMPL
    fi

    local tmp
    tmp=$(mktemp)
    cp "$local_state" "$tmp"

    IFS=',' read -ra profiles <<< "$PROFILE_DIRS"
    local registered=0

    for profile in "${profiles[@]}"; do
        profile=$(echo "$profile" | xargs)
        local profile_path="$HELIUM_DATA_DIR/$profile"
        local prefs="$profile_path/Preferences"

        if [[ ! -d "$profile_path" ]]; then
            continue
        fi

        # Check if already registered
        if jq -e --arg p "$profile" '.profile.info_cache[$p]' "$tmp" &>/dev/null; then
            continue
        fi

        # Read name and avatar from the profile's Preferences
        local display_name="$profile"
        local avatar_index=0
        if [[ -f "$prefs" ]]; then
            display_name=$(jq -r '.profile.name // empty' "$prefs" 2>/dev/null) || true
            avatar_index=$(jq -r '.profile.avatar_index // 0' "$prefs" 2>/dev/null) || true
            [[ -z "$display_name" ]] && display_name="$profile"
        fi

        local now
        now=$(date +%s.%N)
        local next_bucket
        next_bucket=$(jq '.profile.metrics.next_bucket_index // 1' "$tmp")

        msg "Registering profile in Local State: $profile (\"$display_name\")"

        jq --arg p "$profile" \
           --arg name "$display_name" \
           --argjson avatar "$avatar_index" \
           --argjson now "$now" \
           --argjson bucket "$next_bucket" \
        '
          .profile.info_cache[$p] = {
            "active_time": $now,
            "avatar_icon": ("chrome://theme/IDR_PROFILE_AVATAR_" + ($avatar | tostring)),
            "background_apps": false,
            "default_avatar_fill_color": -1,
            "default_avatar_stroke_color": -1,
            "enterprise_label": "",
            "force_signin_profile_locked": false,
            "gaia_given_name": "",
            "gaia_id": "",
            "gaia_name": "",
            "hosted_domain": "",
            "is_consented_primary_account": false,
            "is_ephemeral": false,
            "is_using_default_avatar": true,
            "is_using_default_name": false,
            "managed_user_id": "",
            "metrics_bucket_index": $bucket,
            "name": $name,
            "user_name": ""
          }
          | .profile.metrics.next_bucket_index = ($bucket + 1)
          | .profile.profiles_created = ([.profile.profiles_created, (.profile.info_cache | length)] | max)
          | .profile.profiles_order = (.profile.profiles_order + [$p] | unique)
          | .profile.last_active_profiles = (.profile.last_active_profiles + [$p] | unique)
        ' "$tmp" > "${tmp}.new" && mv "${tmp}.new" "$tmp"

        registered=$((registered + 1))
    done

    if (( registered > 0 )); then
        cp "$tmp" "$local_state"
        msg "Registered $registered new profile(s) in Local State ✓"
    else
        msg "All profiles already registered in Local State ✓"
    fi

    rm -f "$tmp"
}

do_sync() {
    local dry_run="${1:-false}"
    local direction_override="${2:-}"
    load_config

    # Allow callers (e.g. --restore) to override the configured direction
    if [[ -n "$direction_override" ]]; then
        SYNC_DIRECTION="$direction_override"
    fi

    # Locking: prevent overlapping syncs
    exec 200>"$LOCK_FILE"
    if ! flock -n 200; then
        warn "Another sync is already running. Exiting."
        exit 0
    fi

    mkdir -p "$BISYNC_STATE_DIR"

    build_exclude_args

    local -a common_args=(
        --config "$RCLONE_CONF"
        --log-level INFO
        --s3-no-check-bucket
        "${EXCLUDE_ARGS[@]}"
    )

    if [[ "$dry_run" == "true" ]]; then
        common_args+=(--dry-run)
        msg "DRY RUN — no changes will be made"
    fi

    IFS=',' read -ra profiles <<< "$PROFILE_DIRS"
    local failed=0

    for profile in "${profiles[@]}"; do
        profile=$(echo "$profile" | xargs)  # trim whitespace
        local local_path="$HELIUM_DATA_DIR/$profile/"
        local remote_path="helium-s3:$S3_BUCKET/$S3_PREFIX/$profile/"

        if [[ ! -d "$local_path" ]]; then
            warn "Profile directory not found: $local_path — skipping"
            continue
        fi

        msg "Syncing profile: $profile ($SYNC_DIRECTION)"

        case "$SYNC_DIRECTION" in
            upload-only)
                if ! rclone sync "$local_path" "$remote_path" "${common_args[@]}"; then
                    err "Sync failed for profile: $profile"
                    failed=$((failed + 1))
                fi
                ;;
            download-only)
                if ! rclone sync "$remote_path" "$local_path" "${common_args[@]}"; then
                    err "Sync failed for profile: $profile"
                    failed=$((failed + 1))
                fi
                ;;
            bidirectional)
                local resync_flag=""
                local state_file="$BISYNC_STATE_DIR/${profile//[ \/]/_}.state"
                if [[ ! -f "$state_file" ]]; then
                    resync_flag="--resync"
                    msg "First bisync for '$profile' — running with --resync"
                fi
                if rclone bisync "$local_path" "$remote_path" \
                    ${resync_flag} "${common_args[@]}"; then
                    touch "$state_file"
                else
                    err "Bisync failed for profile: $profile"
                    rm -f "$state_file"
                    failed=$((failed + 1))
                fi
                ;;
            *)
                err "Unknown sync direction: $SYNC_DIRECTION"
                exit 1
                ;;
        esac
    done

    if (( failed > 0 )); then
        err "$failed profile(s) failed to sync."
        exit 1
    fi

    msg "All profiles synced successfully ✓"

    # Register profiles in Local State after downloading data
    if [[ "$SYNC_DIRECTION" == "download-only" || "$SYNC_DIRECTION" == "bidirectional" ]]; then
        register_profiles
    fi
}

do_restore() {
    load_config

    warn "This will OVERWRITE local profile data with the S3 copy."
    echo ""

    IFS=',' read -ra profiles <<< "$PROFILE_DIRS"
    local has_existing=false
    for profile in "${profiles[@]}"; do
        profile=$(echo "$profile" | xargs)
        local local_path="$HELIUM_DATA_DIR/$profile"
        if [[ -d "$local_path" ]]; then
            has_existing=true
            local size
            size=$(du -sh "$local_path" 2>/dev/null | cut -f1)
            warn "LOCAL EXISTS: $profile ($size)"
        fi
    done

    if [[ "$has_existing" == "true" ]]; then
        echo ""
        msg "Existing local profiles will be backed up before overwriting."
        echo ""
    fi

    read -rp "Type 'yes' to confirm restore: " confirm
    if [[ "$confirm" != "yes" ]]; then
        echo "Aborted."
        exit 0
    fi

    # ── Back up existing local profiles ──────────────────────
    local backup_ts
    backup_ts=$(date +%Y%m%d-%H%M%S)
    local backup_dir="$CONFIG_DIR/backups/$backup_ts"

    for profile in "${profiles[@]}"; do
        profile=$(echo "$profile" | xargs)
        local local_path="$HELIUM_DATA_DIR/$profile"
        if [[ -d "$local_path" ]]; then
            local dest="$backup_dir/$profile"
            msg "Backing up '$profile' → $dest"
            mkdir -p "$dest"
            cp -a "$local_path/." "$dest/"
        fi
    done

    msg "Local backup saved to: $backup_dir"
    echo ""

    # ── Now do the actual restore ────────────────────────────
    do_sync false "download-only"

    # Register profiles in Local State so Helium recognizes them
    register_profiles

    echo ""
    msg "Restore complete. If something went wrong, recover from:"
    msg "  $backup_dir"
}

do_restore_merge() {
    load_config
    msg "Merging S3 profiles into local (no local files will be deleted)."
    msg "S3 versions win on conflicts (newer overwrites older)."
    echo ""

    IFS=',' read -ra profiles <<< "$PROFILE_DIRS"
    build_exclude_args

    for profile in "${profiles[@]}"; do
        profile=$(echo "$profile" | xargs)
        local local_path="$HELIUM_DATA_DIR/$profile/"
        local remote_path="helium-s3:$S3_BUCKET/$S3_PREFIX/$profile/"

        msg "Merging: $profile"
        rclone copy "$remote_path" "$local_path" \
            --config "$RCLONE_CONF" \
            --log-level INFO \
            --s3-no-check-bucket \
            "${EXCLUDE_ARGS[@]}"
    done

    # Register profiles in Local State so Helium recognizes them
    register_profiles

    msg "Merge complete ✓"
}

case "${1:-}" in
    --setup)
        exec helium-profile-sync-setup
        ;;
    --sync-now)
        msg "Triggering immediate sync..."
        do_sync false
        ;;
    --dry-run)
        do_sync true
        ;;
    --restore)
        do_restore
        ;;
    --restore-merge)
        do_restore_merge
        ;;
    --register)
        load_config
        register_profiles
        ;;
    --status)
        echo -e "\n${BOLD}Timer status:${RESET}"
        systemctl --user status helium-profile-sync.timer --no-pager 2>/dev/null || true
        echo -e "\n${BOLD}Service status:${RESET}"
        systemctl --user status helium-profile-sync.service --no-pager 2>/dev/null || true
        ;;
    --logs)
        journalctl --user -u helium-profile-sync.service --since "24 hours ago" --no-pager
        ;;
    --enable)
        systemctl --user daemon-reload
        systemctl --user enable --now helium-profile-sync.timer
        msg "Timer enabled and started."
        ;;
    --disable)
        systemctl --user disable --now helium-profile-sync.timer
        msg "Timer disabled and stopped."
        ;;
    -h|--help)
        usage
        ;;
    "")
        do_sync false
        ;;
    *)
        err "Unknown option: $1"
        usage
        exit 1
        ;;
esac